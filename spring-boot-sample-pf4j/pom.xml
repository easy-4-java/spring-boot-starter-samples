<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.easy4j</groupId>
        <artifactId>spring-boot-starter-samples</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    
    <artifactId>spring-boot-sample-pf4j</artifactId>
    <name>Spring Boot Pf4j Sample</name>
    <description>Spring Boot Pf4j 1.x Sample</description>
    
    <properties>

        <spring-boot-starter-pf4j.version>1.0.3.RELEASE</spring-boot-starter-pf4j.version>
        <pf4j-plugin-api.version>1.0.x.20260630-SNAPSHOT</pf4j-plugin-api.version>
    </properties>
    
    <dependencies>

        <!-- Compile -->
        <!-- For Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- For Spring Boot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Test -->
        <!-- For Spring Boot Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        
        <!-- Source: https://github.com/easy-4-java/spring-boot-starter-pf4j — easy4j spring-boot-starter-pf4j -->
        <dependency>
            <groupId>io.github.hiwepy</groupId>
            <artifactId>spring-boot-starter-pf4j</artifactId>
        </dependency>
         
        <!-- https://mvnrepository.com/artifact/commons-logging/commons-logging -->
        <dependency>
            <groupId>commons-logging</groupId>
            <artifactId>commons-logging</artifactId>
        </dependency>
        
        <!-- Source: https://github.com/easy-4-java/pf4j-plugin-api — easy4j pf4j-plugin-api -->
        <dependency>
            <groupId>io.github.hiwepy</groupId>
            <artifactId>pf4j-plugin-api</artifactId>
            <version>${pf4j-plugin-api.version}</version>
            <scope>system</scope>
            <systemPath>${basedir}/src/main/resources/pf4j-plugin-api-1.0.0-SNAPSHOT.jar</systemPath>
        </dependency>

    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.hiwepy</groupId>
                <artifactId>pf4j-plugin-api</artifactId>
                <version>${pf4j-plugin-api.version}</version>
                <scope>system</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>


    <build>

        <plugins>
            <!-- https://mvnrepository.com/artifact/org.springframework.boot/spring-boot-maven-plugin -->
            <plugin>
                <!-- Spring Boot 插件：构建可执行 fat-jar -->
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <executable>true</executable>
                    <mainClass>ro.fortsoft.pf4j.spring.boot.Pf4jApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
                <dependencies>
                    <!-- For Spring Springloaded -->
                    <dependency>
                        <groupId>org.springframework</groupId>
                        <artifactId>springloaded</artifactId>
                        <version>1.2.7.RELEASE</version>
                    </dependency>
                </dependencies>
            </plugin>
            <!-- 第一步：生成可执行的启动脚本 -->
            <!-- https://mvnrepository.com/artifact/org.codehaus.mojo/appassembler-maven-plugin -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>appassembler-maven-plugin</artifactId>
            </plugin>
            <!-- 第一步：通过antrun插件拷贝文件 -->
            <!-- https://mvnrepository.com/artifact/org.apache.maven.plugins/maven-antrun-plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
            </plugin>
            <!-- 第三步：通过docker-maven插件构造Docker镜像 <plugin> <groupId>com.spotify</groupId> 
                <artifactId>docker-maven-plugin</artifactId> </plugin> -->
        </plugins>
    </build>


</project>