<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.1.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>

    
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
        <relativePath />
    </parent>
     
    <groupId>io.github.easy4j</groupId>
    <artifactId>spring-boot-starter-samples</artifactId>
    <version>3.0.x.20260630-SNAPSHOT</version>

    <packaging>pom</packaging>
    <name>Spring Boot Starter Samples</name>
    <description>Spring Boot Starter Samples</description>

    <subprojects>

        <subproject>spring-boot-sample-axis2</subproject>
        <subproject>spring-boot-sample-druid</subproject>
        <subproject>spring-boot-sample-ehcache3</subproject>
        <subproject>spring-boot-sample-flyway</subproject>
        <subproject>spring-boot-sample-hikaricp</subproject>
        <subproject>spring-boot-sample-jetbrick</subproject>
        <subproject>spring-boot-sample-kaptcha</subproject>
        <subproject>spring-boot-sample-log4j2</subproject>
        <subproject>spring-boot-sample-pf4j</subproject>
        <subproject>spring-boot-sample-swagger2</subproject>
        <subproject>spring-boot-sample-sharding-jdbc</subproject>
        <subproject>spring-boot-sample-pf4j2</subproject>
    </subprojects>

    <!-- 制品发布仓库配置（distributionManagement） -->
    <distributionManagement>
        <repository>
            <id>2624322-release-6F6h6R</id>
            <url>https://packages.aliyun.com/6927b116e6c3e0425dbdf60d/maven/2624322-release-6f6h6r</url>
        </repository>
        <snapshotRepository>
            <id>2624322-snapshot-3EoOv3</id>
            <url>https://packages.aliyun.com/6927b116e6c3e0425dbdf60d/maven/2624322-snapshot-3eoov3</url>
        </snapshotRepository>
    </distributionManagement>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <maven.version>3.9.16</maven.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <!-- 示例子模块中声明但未指定版本的插件，统一在插件管理中补全版本 -->
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>appassembler-maven-plugin</artifactId>
                    <version>1.10</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-antrun-plugin</artifactId>
                    <version>1.8</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>